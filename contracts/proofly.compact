pragma language_version >= 0.23;

import CompactStandardLibrary;

// Proofly — Level 1 + Level 3: private proof-of-income with replay protection.
//
// Proves the predicate `privateIncome >= requiredMonthlyIncome` without
// revealing the private income. The monthly income is supplied as a Compact
// WITNESS (private); the minimum required income is a PUBLIC circuit
// argument chosen by the verifier.
//
// Level 3: each claim is scoped to a public `applicationId` and made
// single-use via a deterministic, income-independent nullifier
// persistentHash(["proofly:claim:", applicationId, requiredMonthlyIncome,
// applicantId]). The nullifier is derived from the private `applicantId`
// witness (unrelated to income) and is recorded on-chain once; a replayed
// claim is rejected in-chain.
//
// Deliberately minimal: no applicant ids, no Merkle allowlists, no issuer,
// no revocation. Identity, issuer and revocation are later levels.

export ledger proofCount: Field;
export ledger usedNullifiers: Map<Bytes<32>, Boolean>;

constructor() {
  proofCount = 0;
}

witness income(): Uint<32>;
witness applicantId(): Bytes<32>;

export circuit proveIncome(requiredMonthlyIncome: Uint<32>, applicationId: Bytes<32>): [] {
  const privateIncome = income();
  assert(privateIncome >= requiredMonthlyIncome, "Income below required minimum");
  const nullifier = persistentHash<Vector<4, Bytes<32>>>([
    pad(32, "proofly:claim:"),
    applicationId,
    requiredMonthlyIncome as Field as Bytes<32>,
    applicantId()
  ]);
  assert(!usedNullifiers.member(disclose(nullifier)), "Claim already used for this application");
  usedNullifiers.insert(disclose(nullifier), true);
  proofCount = proofCount + 1;
}
