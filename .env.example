# Proofly — OPERATOR-ONLY deployment configuration (root).
#
# THIS FILE MUST NEVER BE COMMITTED OR SHARED. A real value here is a secret.
# The deployer seed is read by scripts/deploy-proofly.ts ONLY from the
# PROOFLY_DEPLOYER_SEED environment variable. The script optionally loads this
# file (and .env.local) because both are gitignored — that convenience never
# ships the secret anywhere else.

# Hex-encoded 32 bytes (64 hex chars). Generate one locally with:
#   openssl rand -hex 32
# Set it here OR export it in your shell; NEVER paste it into chat or CI.
PROOFLY_DEPLOYER_SEED=

# Network guard — must remain 'preprod' (Midnight testnet; no real money).
PROOFLY_NETWORK_ID=preprod

# Public Preprod endpoints (optional overrides; defaults are built in).
# PROOFLY_INDEXER_URL=https://indexer.preprod.midnight.network/api/v4/graphql
# PROOFLY_INDEXER_WS_URL=wss://indexer.preprod.midnight.network/api/v4/graphql/ws
# PROOFLY_NODE_URL=https://rpc.preprod.midnight.network
# PROOFLY_PROOF_SERVER_URL=http://127.0.0.1:6300

# Password protecting the deployer's LOCAL private-state store (LevelDB in
# node_modules). Strong value recommended; placeholder is used only if unset.
PROOFLY_PRIVATE_STATE_PASSWORD=