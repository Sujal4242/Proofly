# Proofly — public environment configuration (Live Preprod mode).
# All values are PUBLIC (network endpoints and an on-chain contract address).
# NEVER put secrets here. NEVER add VITE_INCOME — the monthly income is runtime
# private state that flows only through the `income` witness.

# Network id passed to the Lace wallet's connect().
VITE_NETWORK_ID=preprod

# Deployed Proofly contract address on Preprod.
# Empty by default: Live proof submission stays disabled until a real
# deployment provides this address (see docs/LEVEL2-ARCHITECTURE.md).
# VITE_CONTRACT_ADDRESS=

# Fallback indexer endpoints (the wallet's own configuration wins when set).
VITE_INDEXER_URL=https://indexer.preprod.midnight.network/api/v4/graphql
VITE_INDEXER_WS_URL=wss://indexer.preprod.midnight.network/api/v4/graphql/ws